# =================================
# VoIP SaaS Platform Configuration
# =================================
# With NODE_ENV=production the backend refuses to start unless JWT_SECRET,
# DATABASE_URL, the Stripe and Telnyx settings and both URLs are set, the URLs
# are https, and JWT_SECRET is at least 32 characters and not a placeholder.

# Node Environment
NODE_ENV=development

# Server
PORT=5000
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Number of reverse proxies in front of the API (0 if it is exposed directly).
# Rate limits are per client IP, so this must match your deployment.
TRUST_PROXY=1

# =================================
# Database (PostgreSQL)
# =================================
DATABASE_URL=postgres://postgres:postgres@localhost:5432/voip_saas
# Optional: run inside a schema other than "public"
# DB_SCHEMA=

# Backend database tests (optional locally, required in CI). Each test file
# creates and drops its own schema in this database.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/voip_saas

# =================================
# Redis (rate limits, rates cache)
# =================================
# If Redis is unreachable, rate limits are counted per process instead.
REDIS_URL=redis://localhost:6379

# =================================
# Authentication (JWT)
# =================================
# Generate one with: openssl rand -hex 48
# Leave it unset in development to get a random key per process.
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# =================================
# Telnyx (VoIP Provider)
# =================================
# Get keys at: https://portal.telnyx.com
TELNYX_API_KEY=KEY_xxx
# Public key used to verify webhook signatures (Ed25519, base64)
TELNYX_PUBLIC_KEY=KEY_xxx
TELNYX_SIP_CONNECTION_ID=xxx

# =================================
# Stripe (Payments)
# =================================
# Get keys at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# =================================
# Security and limits
# =================================
BCRYPT_ROUNDS=12
# General API limit per client IP
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
# Outbound calls one user may have open at once
MAX_CONCURRENT_CALLS=2

# =================================
# Mobile app (packages/mobile)
# =================================
# Your backend, including the /api path. Expo inlines EXPO_PUBLIC_* at build time.
# EXPO_PUBLIC_API_URL=https://api.example.com/api
