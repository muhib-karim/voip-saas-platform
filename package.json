{
  "name": "voip-saas-platform",
  "version": "1.0.0",
  "description": "Skype-like VoIP SaaS Platform with WebRTC Softphone",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace=packages/backend",
    "dev:frontend": "npm run dev --workspace=packages/frontend",
    "dev:mobile": "npm run start --workspace=packages/mobile",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "npm run lint --workspaces",
    "db:migrate": "npm run db:migrate --workspace=packages/backend",
    "docker:dev": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    },
    "@expo/fingerprint": {
      "minimatch": "^11.0.1"
    },
    "postcss": "^8.5.23",
    "send": "^0.19.0",
    "@xmldom/xmldom": "^0.8.15",
    "decode-uri-component": "^0.5.1",
    "fast-xml-parser": "^5.12.0",
    "image-size": "^2.0.3",
    "tar": "^7.5.21",
    "semver": "^7.5.2",
    "vitest": {
      "tinypool": "^2.2.0"
    }
  }
}
